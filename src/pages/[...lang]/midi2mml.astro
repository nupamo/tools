---
import Layout from '../../layouts/Layout.astro';
import Midi2Mml from '../../components/Midi2Mml';
import ProcessingInfo from '../../components/ProcessingInfo';
import { tools } from '../../data/tools';
import { getMessages, localeStaticPaths, type Locale } from '../../i18n';
export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const tool = tools.find(t => t.slug === 'midi2mml')!;
const name = tool.name[locale];
---
<Layout title={name} description={tool.description[locale]} locale={locale} path="midi2mml/" workspace>
  <div class="tool-heading">
    <h1>{name}</h1>
    <ProcessingInfo processing={tool.processing} locale={locale} />
  </div>
  <Midi2Mml client:load locale={locale} label={name} />
  <noscript><p class="noscript-message">{getMessages(locale).midi.noscript}</p></noscript>
</Layout>
