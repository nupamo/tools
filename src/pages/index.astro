---
import Layout from '../layouts/Layout.astro';
import { tools } from '../data/tools';
const base = import.meta.env.BASE_URL;
---
<Layout title="tools" description="직접 쓰려고 만든 작은 도구들.">
  <div class="directory">
    <h1>tools</h1>
    <p class="directory-description">직접 쓰려고 만든 작은 도구들.</p>
    <nav class="tool-list" aria-label="도구">
      {tools.map(tool => (
        <a class="tool-link" href={`${base}${tool.slug}/`}>
          <div class="tool-copy"><strong>{tool.name}</strong><span>{tool.description}</span></div>
          <span class="category">{tool.category}</span>
          <span class="tool-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
    <p class="directory-note">필요한 도구를 골라 쓰세요.</p>
  </div>
</Layout>
