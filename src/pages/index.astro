---
import Layout from '../layouts/Layout.astro';
import { tools, projects, type HomeIconName } from '../data/tools';
import { Aperture, ArrowUpRight, Bot } from 'lucide-react';
const base = import.meta.env.BASE_URL;
const icons = { aperture: Aperture, bot: Bot } satisfies Record<HomeIconName, unknown>;
---
<Layout title="tools" description="직접 쓰려고 만든 작은 도구들." home>
  <nav slot="header-nav" class="header-nav" aria-label="바로가기">
    <a class="header-link" href="#tools-list">도구</a>
    <a class="header-link" href="#projects-list">프로젝트</a>
  </nav>
  <div class="directory">
    <h1>tools</h1>
    <p class="directory-description">직접 쓰려고 만든 작은 도구들.</p>
    <nav id="tools-list" class="tool-grid" aria-label="도구">
      {tools.map(tool => {
        const Icon = icons[tool.icon];
        return (
          <a class="tool-tile" href={`${base}${tool.slug}/`}>
            <Icon className="tool-tile-icon" size={36} aria-hidden="true" />
            <div class="tool-copy"><strong>{tool.name}</strong><span>{tool.description}</span></div>
          </a>
        );
      })}
    </nav>
    {projects.length > 0 && (
      <section id="projects-list" class="projects" aria-labelledby="projects-heading">
        <div class="section-divider"><h2 id="projects-heading">다른 프로젝트</h2></div>
        <nav class="tool-grid" aria-labelledby="projects-heading">
          {projects.map(project => {
            const Icon = icons[project.icon];
            return (
              <a class="tool-tile" href={project.href} target="_blank" rel="noopener">
                <Icon className="tool-tile-icon" size={36} aria-hidden="true" />
                <div class="tool-copy">
                  <strong>{project.name}<ArrowUpRight className="external-mark" size={14} aria-hidden="true" /><span class="visually-hidden">(새 창에서 열림)</span></strong>
                  <span>{project.description}</span>
                  <small>{project.domain}</small>
                </div>
              </a>
            );
          })}
        </nav>
      </section>
    )}
  </div>
</Layout>
